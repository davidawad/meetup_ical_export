# Copy this file to .env and fill in real values — .env itself is gitignored,
# this file (.env.example) is the tracked, secret-free record of every
# environment variable the project reads.

# --- required: from your Meetup OAuth consumer -------------------------------
# Register one at https://www.meetup.com/api/oauth/list/
MEETUP_CLIENT_ID=
MEETUP_CLIENT_SECRET=

# --- optional ----------------------------------------------------------------
# Must match (or start with) the redirect URI registered on the consumer.
MEETUP_REDIRECT_URI=http://localhost:5000/oauth2/callback

# Where the OAuth2 access/refresh token pair is persisted. Gitignored.
MEETUP_TOKEN_CACHE=.token_cache.json

# Meetup's GraphQL endpoint. Override only for testing.
MEETUP_API_URL=https://api.meetup.com/gql-ext

# IANA timezone name written to the calendar's X-WR-TIMEZONE.
OUTPUT_TIMEZONE=America/New_York

# How long a rendered feed is served before we go back to Meetup.
CACHE_TTL_HOURS=24

# Signs the session cookie that carries the OAuth `state` value. Defaults to a
# random per-process value, which is fine for a single-user deployment.
FLASK_SECRET_KEY=

# Verbose logging, and only query the first group (keeps API usage down).
DEBUG=
