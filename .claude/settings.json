{
  "enabledPlugins": {
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "compound-engineering-plugin": {
      "source": {
        "repo": "EveryInc/compound-engineering-plugin",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto-push-after-commit.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-cleanup-on-merge.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dependency-vuln-scan.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/conventional-commits-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/semver-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/credential-exfil-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/semgrep-sast-gate.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/osv-scanner-gate.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/snyk-gate.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/primary-checkout-mutation-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pip-install-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lockfile-drift-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/python-version-consistency-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/package-freshness-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pypi-token-exfil-guard.sh",
            "type": "command"
          },
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/python-line-count-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-write-protected-branch-guard.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|NotebookEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}